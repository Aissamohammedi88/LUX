def style_inline(attrs, theme):
mapping = {
"couleur": "color", "taille": "font-size", "poids": "font-weight",
"fond": "background", "bord": "border", "bord_couleur": "border-color",
"marge": "margin", "pad": "padding", "largeur": "width",
"hauteur": "height", "radius": "border-radius", "opacite": "opacity",
"espace": "letter-spacing", "ligne": "line-height",
"flex": "display", "gap": "gap", "align": "align-items",
"justify": "justify-content", "ombre": "box-shadow",
"transformation": "text-transform", "italique": "font-style",
"deco": "text-decoration", "overflow": "overflow",
"position": "position", "top": "top", "left": "left",
"right": "right", "bottom": "bottom", "z": "z-index",
"curseur": "cursor", "wrap": "flex-wrap", "direction": "flex-direction",
"transition": "transition", "transform": "transform",
}
styles = []
for k, v in attrs.items():
if k in mapping:
css_key = mapping[k]
if css_key in ("font-size", "padding", "margin", "width", "height",
"border-radius", "gap", "top", "left", "right", "bottom",
"letter-spacing") and v.isdigit():
v = v + "px"
if css_key == "display" and v == "oui":
v = "flex"
if css_key == "text-align" and v == "oui":
v = "center"
if css_key == "font-style" and v == "oui":
v = "italic"
if css_key == "text-transform" and v == "oui":
v = "uppercase"
styles.append(css_key + ": " + v)
return "; ".join(styles)


