class Handler(BaseHTTPRequestHandler):
def log_message(self, *a):
pass

def _send(self, code, content, ctype="text/html"):
try:
self.send_response(code)
self.send_header("Content-Type", ctype + "; charset=utf-8")
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Cache-Control", "no-cache")
self.send_header("Content-Length", str(len(content)))
self.end_headers()
self.wfile.write(content)
except (BrokenPipeError, ConnectionResetError):
pass

def do_GET(self):
p = self.path.split("?")[0]

if p in ("/", "/index.html"):
with ETAT["lock"]:
h = ETAT["html"] or compiler(ETAT["lux"])
return self._send(200, h.encode("utf-8"), "text/html")

if p == "/lux":
with ETAT["lock"]:
return self._send(200, ETAT["lux"].encode("utf-8"), "text/plain")

if p == "/api/sante":
with ETAT["lock"]:
return self._send(200, json.dumps({
"ok": True, "version": VERSION,
"themes": list(THEMES.keys()),
"primitives": 60,
"taille_lux": len(ETAT["lux"]),
"taille_html": len(ETAT["html"]),
}, ensure_ascii=False).encode())

return self._send(404, b"not found", "text/plain")

def do_POST(self):
if self.path == "/api/compiler":
try:
length = int(self.headers.get("Content-Length", 0))
body = self.rfile.read(length).decode("utf-8")
data = json.loads(body)
lux = data.get("lux", "")
if lux:
with ETAT["lock"]:
ETAT["lux"] = lux
ETAT["html"] = compiler(lux)
return self._send(200, json.dumps({"ok": True}).encode())
except Exception as e:
return self._send(500, json.dumps({"erreur": str(e)}).encode())
return self._send(404, b"not found")


class Server(ThreadingMixIn, HTTPServer):
daemon_threads = True
allow_reuse_address = True


def ip_locale():
try:
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.connect(("8.8.8.8", 80))
ip = s.getsockname()[0]
s.close()
return ip
except Exception:
return "localhost"


